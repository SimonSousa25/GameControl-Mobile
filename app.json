{
  "expo": {
    "name": "game-control-mobile",
    "slug": "game-control-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gamecontrolmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.gamecontrolmobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Orbitron.ttf",
            "./assets/fonts/OrbitronMedium.ttf",
            "./assets/fonts/OrbitronBold.ttf",
            "./assets/fonts/OrbitronBlack.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03070D"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
