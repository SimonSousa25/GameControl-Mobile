# Copie para .env.local e preencha. Depois reinicie com: npx expo start -c
#
# Firebase Console -> Configurações do projeto -> Seus apps -> app "Web"
# (adicione um app Web se ainda não existir). Valores não são segredos.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL da API (no celular use o IP da máquina na rede, não localhost)
EXPO_PUBLIC_API_URL=http://SEU_IP:8080/api
